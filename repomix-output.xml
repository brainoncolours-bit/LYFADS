  line-height: 1.7;
  color: var(--text-secondary);
  font-weight: 300;
  max-width: 100%;
}

/* Stats/Numbers */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
  gap: 24px;
  margin-top: 32px;
}

.stat-item {
  border-left: 2px solid var(--accent-red);
  padding-left: 16px;
}

.stat-number {
  font-size: 40px;
  font-weight: 900;
  font-style: italic;
  color: var(--text-primary);
  line-height: 1;
}

.stat-label {
  font-size: 10px;
  font-family: 'JetBrains Mono', monospace;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text-tertiary);
  margin-top: 6px;
}

/* Buttons - Brutalist Style */
.button {
  padding: 14px 32px;
  border: 2px solid var(--text-primary);
  background: transparent;
  font-weight: 800;
  font-size: 11px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.15em;
  color: var(--text-primary);
  text-transform: uppercase;
  transition: all 0.3s ease;
  cursor: pointer;
  font-style: italic;
  position: relative;
  overflow: hidden;
}

.button:hover {
  background: var(--accent-red);
  border-color: var(--accent-red);
  color: var(--text-primary);
  transform: translateY(-2px);
}

.bounce {
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-10px);
  }
  60% {
    transform: translateY(-5px);
  }
}

/* Hero Section - Full Screen Intro */
.hero--container {
  position: relative;
  width: 100%;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.hero--content {
  opacity: 0;
  z-index: 2;
}

.hero--content h1 {
  font-size: clamp(60px, 12vw, 180px);
  font-weight: 900;
  font-style: italic;
  line-height: 0.85;
  letter-spacing: -0.04em;
  color: var(--text-primary);
  margin-bottom: 30px;
}

.hero--content h1 span {
  color: var(--accent-red);
}

.hero--content p {
  font-size: 14px;
  font-family: 'JetBrains Mono', monospace;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-tertiary);
  margin-bottom: 60px;
}

.hero--scroller--container {
  position: fixed;
  bottom: 60px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
}

.hero--scroller {
  opacity: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
}

.hero--scroller--text {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-tertiary);
}

/* About Sections with Camera Landing */
.about--section {
  opacity: 0;
}

/* Team Section */
.team--container,
.vision--container,
.approach--container,
.equipment--container {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Exit/Explore Mode */
.exit--container {
  display: none;
  position: fixed;
  bottom: 60px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 200;
  pointer-events: none;
}

.button--secondary {
  font-weight: 700;
  font-size: 11px;
  display: flex;
  align-items: center;
  letter-spacing: 0.15em;
  color: var(--text-primary);
  transition: all 0.3s ease;
  background: var(--bg-black);
  z-index: 2;
  padding: 14px 32px;
  border: 2px solid var(--text-primary);
  text-transform: uppercase;
  pointer-events: auto;
  cursor: pointer;
  font-style: italic;
}

.button--secondary:hover {
  background: var(--accent-red);
  border-color: var(--accent-red);
}

/* Mobile Responsive */
@media (max-width: 1024px) {
  .text-content {
    padding: 35px;
    max-width: 450px;
    margin: 0 auto !important;
  }

  .text-left .text-content,
  .text-right .text-content {
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .section {
    padding: 60px 5vw;
  }

  .section-number {
    font-size: 80px;
    opacity: 0.5;
  }

  .section-title {
    font-size: clamp(28px, 5vw, 48px);
  }

  #webgi-canvas-container {
    opacity: 0.5;
  }
}

@media (max-width: 768px) {
  .text-content {
    padding: 28px;
