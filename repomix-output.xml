<file path="app/camera-landing.css">
/* LYF ADS - Brutalist About Us with Camera Landing Zones */
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@300;400;500;600&display=swap');

:root {
  --bg-black: #080808;
  --accent-red: #dc2626;
  --accent-red-dark: #991b1b;
  --text-primary: #ffffff;
  --text-secondary: rgba(255, 255, 255, 0.6);
  --text-tertiary: rgba(255, 255, 255, 0.3);
  --border-color: rgba(255, 255, 255, 0.1);
}

* {
  font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
}

.camera-landing-wrapper {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background: var(--bg-black);
  overflow-x: hidden;
}

/* Canvas - Adapts to Landing Zones */
#webgi-canvas-container {
  width: 100vw;
  height: 100vh;
  margin: 0;
  padding: 0;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 0;
  pointer-events: none;
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

#webgi-canvas-container canvas {
  width: 100%;
  height: 100%;
}

/* Landing Zone Indicator */
.landing-zone {
  position: absolute;
  border: 1px dashed var(--accent-red);
  opacity: 0;
  pointer-events: none;
  z-index: 1;
  transition: opacity 0.5s;
}

.landing-zone.active {
  opacity: 0.3;
}


/* Brutalist Header */
.header {
  position: fixed;
  z-index: 100;
  display: flex;
  width: 100%;
  justify-content: center;
  top: 0;
  background: var(--bg-black);
  padding: 30px 0;
  border-bottom: 1px solid var(--border-color);
}

.header--container {
  display: flex;
  width: 90vw;
  max-width: 1600px;
  justify-content: space-between;
  align-items: center;
  opacity: 0;
}

.header--brand {
  font-size: 24px;
  font-weight: 900;
  letter-spacing: -0.02em;
  color: var(--text-primary);
  user-select: none;
  font-style: italic;
}

.header--menu {
  display: inline-flex;
  gap: 0;
  align-items: center;
  list-style: none;
}

.header--menu li {
  padding: 8px 20px;
  color: var(--text-tertiary);
  transition: all 0.3s ease;
  cursor: pointer;
  user-select: none;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  position: relative;
  font-family: 'JetBrains Mono', monospace;
}

.header--menu li:hover {
  color: var(--accent-red);
}

/* Full Width Sections - Dynamic Text Positioning */
.section {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 80px 5vw;
  user-select: none;
}

/* Text Content Area - Dynamic Positioning */
.text-content {
  position: relative;
  max-width: 500px;
  z-index: 2;
  padding: 40px 45px;
  background: rgba(8, 8, 8, 0.9);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(220, 38, 38, 0.2);
}

/* Left Aligned Text (Camera on Right) */
.text-left .text-content {
  margin-right: auto;
  margin-left: 8vw;
}

/* Right Aligned Text (Camera on Left) */
.text-right .text-content {
  margin-left: auto;
  margin-right: 8vw;
}

/* Section Number */
.section-number {
  position: absolute;
  top: 5%;
  right: 5%;
  font-size: clamp(80px, 15vw, 180px);
  font-weight: 900;
  color: rgba(220, 38, 38, 0.08);
