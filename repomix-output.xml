  const handleChange = (e) => {
    const { name, value } = e.target;
    setFormData((prev) => ({ ...prev, [name]: value }));
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    alert("Thank you for your enquiry! We will contact you soon.");
    setFormData({ name: "", contact: "", email: "", projectDate: "" });
