                >
                  {/* Car Image */}
                  <motion.div
                    initial={{ opacity: 0.4, scale: 1.2 }}
                    whileInView={{ opacity: 1, scale: 1 }}
                    transition={{ duration: 1, delay: index * 0.1, ease: "anticipate" }}
                    viewport={{ amount: 0.2 }}
                    className="relative h-48 w-full"
                  >
                    <Image
                      src={car.image_url || "/herBg.jpg"}
