export const isDirectVideoSource = (url = "") => {
  const cleanUrl = url.split("?")[0].toLowerCase();
  return /\.(mp4|webm|ogg|mov|m4v)$/.test(cleanUrl);
};

export const getPlayableVideoUrl = (url = "") => {
  if (!url) return "";

