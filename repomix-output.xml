      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#d33',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Yes, delete category',
    });

    if (!result.isConfirmed) return;

    const { error } = await supabase
      .from('video_categories')
      .delete()
