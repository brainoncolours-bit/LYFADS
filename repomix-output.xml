              </span>
            </label>

            {editingCategory?.carousel_video_url && !categoryVideoFile && (
              <a
                href={editingCategory.carousel_video_url}
                target="_blank"
                rel="noreferrer"
                className="mt-2 block text-xs font-medium text-blue-600 underline"
              >
                Current video saved
              </a>
            )}
          </div>
        </div>
      </Modal>
    </div>
  );
};

export default WorksList;
